{
  "name": "andrey-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:content": "node --test scripts/content-validation.test.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "vk:preview": "node scripts/vk-publish.mjs preview",
    "vk:publish": "node scripts/vk-publish.mjs publish",
    "vk:auth": "node scripts/vk-auth.mjs",
    "test:vk": "node --test scripts/vk-publish.test.mjs scripts/vk-auth.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:content && npm run test:vk && npm run verify:content && npm run build && npm run verify:export"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5.5.4"
  }
}
